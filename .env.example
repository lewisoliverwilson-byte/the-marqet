# AWS Amplify — provisioned automatically by `amplify push`
# Do not set these manually; Amplify injects them at build time.

# Stripe — get your publishable key from dashboard.stripe.com/apikeys
# Used for future Stripe.js integrations. Payment Links work without this.
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Legacy Supabase keys (project migrated to Amplify — these are unused)
# VITE_SUPABASE_URL=https://your-project-id.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key-here
